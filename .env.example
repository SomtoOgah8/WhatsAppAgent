# Copy to .env and fill in. Never commit .env.

# --- Agent service ---
PORT=8080
# DRY_RUN=1 prints outgoing WhatsApp messages instead of calling Meta.
DRY_RUN=1
DB_PATH=./data/agent.sqlite

# --- WhatsApp Business Platform (Cloud API) ---
WA_API_VERSION=v21.0
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# App secret: used to verify the X-Hub-Signature-256 header on every webhook call.
WA_APP_SECRET=
# Any random string; enter the same value in the Meta webhook settings.
WA_VERIFY_TOKEN=
# Approved template names (see templates/).
WA_TEMPLATE_OPENING=olive_reactivation_opening
WA_TEMPLATE_DEPOSIT=olive_reward_deposit_received
WA_TEMPLATE_PROGRESS=olive_reward_progress
WA_TEMPLATE_PAID=olive_reward_paid
WA_TEMPLATE_REMINDER=olive_reward_reminder
WA_TEMPLATE_LANG=en

# --- Olive gateway ---
# "inprocess" uses the mock gateway directly (no network). Otherwise the gateway's base URL.
GATEWAY_URL=inprocess
GATEWAY_TOKEN=change-me

# --- Language understanding (optional) ---
# Leave empty to use the built-in keyword matcher only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Campaign ---
CAMPAIGN_ID=pilot-1
CONTROL_GROUP_SHARE=0.3
SEND_RATE_PER_MINUTE=30

# --- Mock gateway (sandbox stand-in) ---
MOCK_GATEWAY_PORT=8090
MOCK_GATEWAY_TOKEN=change-me
REWARD_DAILY_CAP_NGN=50000
